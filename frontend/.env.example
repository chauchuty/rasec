# Configuração do FRONTEND — RASEC Espetinhos
# ⚠ Arquivos .env de site estático NÃO são lidos em runtime (não existe
# "servidor" para interpretá-lo). Este arquivo serve de documentação e
# referência para o paso de build (ver notas abaixo).
# Nunca versione segredos aqui — este projeto não tem nenhum, pois dados
# sensíveis (senhas, banco) ficam somento no backend.

# ── Endereço da API ────────────────────────────────────────────
# Deixe vazio para usar caminho relativo './api/...' (padrão).
# Necesário apenas se o backend rodar em outro domínio sem um proxy/rewrite:
# RASEC_API_BASE=https://rasec-api.onrender.com

# ── Personalização (olha a cara do totem) ─────────────────────
RASEC_NOME_LOJA=RASEC
RASEC_SUBTITULO=ESPETINHOS
